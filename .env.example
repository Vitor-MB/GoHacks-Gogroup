# Configuração pública do Supabase para a GOB-02.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Configuração exclusiva do servidor.
# Chave privilegiada do Supabase para importação e processamento interno.
SUPABASE_SECRET_KEY=

# Proxy Claude do evento. Preencher com os dados confirmados na GOB-07.
# Base do proxy (formato OpenAI; com ou sem /v1), ex.: https://ai-proxy.gogroupbr.com
CLAUDE_PROXY_URL=
CLAUDE_PROXY_TOKEN=
CLAUDE_MODEL=
# Roteamento adaptativo (GOB-13): dois modelos distintos ativam economy/reasoning. Sem eles, vale o modelo único CLAUDE_MODEL.
# Ex.: CLAUDE_MODEL_ECONOMY=glm-5.3-flash e CLAUDE_MODEL_REASONING=glm-5.3. CLAUDE_ROUTING: adaptive (padrão) | reasoning_only | economy_only.
CLAUDE_MODEL_ECONOMY=
CLAUDE_MODEL_REASONING=
CLAUDE_ROUTING=

# Credencial dedicada para autenticar o agendador na GOB-10.
CRON_SECRET=

# Credencial dedicada da entrada de contatos simulados (GOB-04). Gere um valor longo e aleatório.
INTAKE_SECRET=
